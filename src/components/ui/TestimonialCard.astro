---
import type { Testimonial } from "../../data/testimonials";

interface Props {
    testimonial: Testimonial;
}

const { testimonial } = Astro.props;
---

<article
    class="testimonial-card"
    data-testimonial-card
    aria-label={`Testimonio de ${testimonial.studentName}`}
>
    <!-- Decorative guillemet -->
    <div class="testimonial-card__guillemet" aria-hidden="true">«</div>

    <!-- Stars -->
    <div class="testimonial-card__stars" aria-label="5 estrellas">
        <span aria-hidden="true">★★★★★</span>
    </div>

    <!-- Quote -->
    <blockquote class="testimonial-card__quote" data-quote>
        {testimonial.quote}
    </blockquote>

    <!-- Toggle button -->
    <button
        type="button"
        class="testimonial-card__toggle"
        data-toggle
        aria-expanded="false"
        aria-label="Ver más del testimonio"
    >
        <span data-toggle-text>Ver más</span>
    </button>

    <!-- Avatar row -->
    <footer class="testimonial-card__footer">
        <div class="avatar" aria-hidden="true">
            {testimonial.initials}
        </div>
        <div class="testimonial-card__info">
            <p class="testimonial-card__name">{testimonial.studentName}</p>
            <p class="testimonial-card__meta">
                {testimonial.context} · {testimonial.location}
            </p>
        </div>
    </footer>
</article>

<style>
    .testimonial-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        padding: var(--space-6);
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        transition:
            border-color var(--transition-base),
            transform var(--transition-base),
            box-shadow var(--transition-base);
        height: 100%;
    }

    .testimonial-card:hover {
        border-color: var(--accent-light);
        transform: translateY(-4px);
        box-shadow: var(--shadow-hover);
    }

    /* Guillemet */
    .testimonial-card__guillemet {
        font-family: var(--font-heading);
        font-size: 80px;
        font-weight: 700;
        color: var(--accent-primary);
        opacity: 0.4;
        line-height: 0.6;
        user-select: none;
    }

    /* Stars */
    .testimonial-card__stars {
        color: var(--accent-light);
        font-size: var(--text-sm);
        letter-spacing: 2px;
    }

    /* Quote with line-clamp */
    .testimonial-card__quote {
        font-family: var(--font-heading);
        font-style: italic;
        font-size: var(--text-xl);
        color: var(--color-white);
        line-height: 1.6;
        flex: 1;
        border: none;
        padding: 0;
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Expanded state: remove line-clamp */
    .testimonial-card.is-expanded .testimonial-card__quote {
        -webkit-line-clamp: unset;
        overflow: visible;
    }

    /* Toggle button */
    .testimonial-card__toggle {
        display: inline-flex;
        align-items: center;
        gap: var(--space-1);
        padding: var(--space-2) 0;
        margin-top: calc(var(--space-1) * -1);
        background: transparent;
        border: none;
        color: var(--accent-light);
        font-family: var(--font-body);
        font-size: var(--text-sm);
        font-weight: 500;
        cursor: pointer;
        transition: color var(--transition-fast);
        align-self: flex-start;
    }

    .testimonial-card__toggle:hover {
        color: var(--accent-primary);
    }

    .testimonial-card__toggle:focus-visible {
        outline: 2px solid var(--accent-light);
        outline-offset: 2px;
        border-radius: var(--radius-sm);
    }

    /* Hide toggle button when not needed */
    .testimonial-card__toggle.is-hidden {
        display: none;
    }

    /* Footer */
    .testimonial-card__footer {
        display: flex;
        align-items: center;
        gap: var(--space-1);
        margin-top: var(--space-1);
    }

    .avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--color-purple), #3d1f6b);
        color: var(--color-white);
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .testimonial-card__name {
        font-family: var(--font-body);
        font-size: var(--text-sm);
        font-weight: 600;
        color: var(--color-white);
    }

    .testimonial-card__meta {
        font-family: var(--font-body);
        font-size: var(--text-xs);
        color: var(--color-gray);
        margin-top: 2px;
    }
</style>

<script>
    document.addEventListener('click', (e) => {
        if (!(e.target instanceof Element)) return;

        const toggleBtn = e.target.closest('[data-toggle]');
        if (!toggleBtn) return;

        const card = toggleBtn.closest('[data-testimonial-card]');
        if (!card) return;

        e.preventDefault();
        e.stopPropagation();

        card.classList.toggle('is-expanded');
        const isExpanded = card.classList.contains('is-expanded');

        toggleBtn.setAttribute('aria-expanded', String(isExpanded));

        const toggleText = toggleBtn.querySelector('[data-toggle-text]');
        if (toggleText) {
            toggleText.textContent = isExpanded ? 'Ver menos' : 'Ver más';
        }

        toggleBtn.setAttribute(
            'aria-label',
            isExpanded ? 'Ver menos del testimonio' : 'Ver más del testimonio',
        );
    });

    document.querySelectorAll<HTMLElement>('[data-testimonial-card]').forEach((card) => {
        const toggleBtn = card.querySelector('[data-toggle]');
        const quoteEl = card.querySelector('[data-quote]');

        if (toggleBtn && quoteEl && quoteEl.scrollHeight <= quoteEl.clientHeight) {
            toggleBtn.classList.add('is-hidden');
        }
    });
</script>
