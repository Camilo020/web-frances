---
interface Props {
  style?: 'line' | 'dots' | 'fleur';
}

const { style = 'line' } = Astro.props;
---

{style === 'line' && (
  <hr class="divider divider--line" role="separator" />
)}

{style === 'dots' && (
  <div class="divider divider--dots" role="separator" aria-hidden="true">
    <span>·</span><span>·</span><span>·</span>
  </div>
)}

{style === 'fleur' && (
  <div class="divider divider--fleur" role="separator" aria-hidden="true">
    <span class="divider__line"></span>
    <svg class="divider__fleur" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <!-- Fleur-de-lis -->
      <path d="M12 2C11.1 2 10.4 2.6 10.2 3.4C9.5 3.2 8.8 3.4 8.4 4C8 4.6 8.1 5.3 8.5 5.8C7.8 5.9 7.3 6.5 7.3 7.2C7.3 7.9 7.8 8.5 8.5 8.7C8.5 8.7 9 9.2 10 10C9 10 7.5 10 6.5 11C5.5 12 5.5 13.5 6.5 14.5C7 15 7.5 15.2 8 15.3L7 19H9L9.8 15.7C10.5 15.9 11.2 16 12 16C12.8 16 13.5 15.9 14.2 15.7L15 19H17L16 15.3C16.5 15.2 17 15 17.5 14.5C18.5 13.5 18.5 12 17.5 11C16.5 10 15 10 14 10C15 9.2 15.5 8.7 15.5 8.7C16.2 8.5 16.7 7.9 16.7 7.2C16.7 6.5 16.2 5.9 15.5 5.8C15.9 5.3 16 4.6 15.6 4C15.2 3.4 14.5 3.2 13.8 3.4C13.6 2.6 12.9 2 12 2Z" />
    </svg>
    <span class="divider__line"></span>
  </div>
)}

<style>
  .divider {
    margin: var(--space-4) 0;
  }

  /* Line */
  .divider--line {
    border: none;
    border-top: 1px solid var(--border-color);
  }

  /* Dots */
  .divider--dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    font-family: var(--font-body);
    font-size: var(--text-lg);
    color: var(--color-gray);
  }

  /* Fleur */
  .divider--fleur {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
  }

  .divider__line {
    flex: 1;
    height: 1px;
    background: var(--border-color);
    max-width: 120px;
  }

  .divider__fleur {
    width: 20px;
    height: 20px;
    color: var(--accent-light);
    flex-shrink: 0;
  }
</style>
