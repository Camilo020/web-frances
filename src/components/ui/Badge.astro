---
import { Icon } from "astro-icon/components";

interface Props {
    icon: string;
    label: string;
    size?: "sm" | "md";
}

const { icon, label, size = "md" } = Astro.props;
---

<div class:list={["badge", `badge--${size}`]}>
    <Icon name={icon} class="badge__icon" aria-hidden="true" />
    <span class="badge__label">{label}</span>
</div>

<style>
    .badge {
        display: inline-flex;
        align-items: center;
        gap: var(--space-1);
        border: 1px solid var(--border-color);
        background: rgba(96, 64, 153, 0.08);
        border-radius: var(--radius-md);
        transition:
            border-color var(--transition-base),
            background var(--transition-base);
    }

    .badge--sm {
        padding: 6px 12px;
        gap: 6px;
    }

    .badge--md {
        padding: 10px 16px;
        gap: var(--space-1);
    }

    .badge__icon {
        width: 18px;
        height: 18px;
        color: var(--accent-light);
        flex-shrink: 0;
    }

    .badge--sm .badge__icon {
        width: 14px;
        height: 14px;
    }

    .badge__label {
        font-family: var(--font-body);
        font-size: var(--text-sm);
        font-weight: 500;
        color: var(--color-white);
    }

    .badge--sm .badge__label {
        font-size: var(--text-xs);
    }
</style>
