---
import BaseLayout from "../../components/layout/BaseLayout.astro";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import { getReadingTime, getArticleMeta } from "../../lib/utils";
import Divider from "../../components/ui/Divider.astro";
import Button from "../../components/ui/Button.astro";

export async function getStaticPaths() {
    const posts = await getCollection("blog", ({ data }) => !data.draft);
    return posts.map((post) => ({
        params: { slug: post.slug },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const readingTime = post.data.readingTime ?? getReadingTime(post.body ?? "");
const meta = getArticleMeta(post.data.pubDate, readingTime);

// Related posts: same category, different slug, max 2
const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const relatedPosts = allPosts
    .filter(
        (p) => p.slug !== post.slug && p.data.category === post.data.category,
    )
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
    .slice(0, 2);
---

<BaseLayout title={post.data.title} description={post.data.description}>
    <article class="post" aria-labelledby="post-title">
        <!-- Hero -->
        <header class="post__hero">
            <div class="post__hero-bg" aria-hidden="true"></div>
            <div class="container post__hero-content">
                <!-- Breadcrumb -->
                <nav class="post__breadcrumb" aria-label="Ruta de navegación">
                    <a href="/" class="post__breadcrumb-link">Inicio</a>
                    <Icon
                        name="tabler:chevron-right"
                        class="post__breadcrumb-sep"
                        aria-hidden="true"
                    />
                    <a href="/blog" class="post__breadcrumb-link">Blog</a>
                    <Icon
                        name="tabler:chevron-right"
                        class="post__breadcrumb-sep"
                        aria-hidden="true"
                    />
                    <span class="post__breadcrumb-current" aria-current="page"
                        >{post.data.category}</span
                    >
                </nav>

                <span class="post__category">{post.data.category}</span>
                <h1 class="post__title" id="post-title">{post.data.title}</h1>
                {
                    post.data.titleFr && (
                        <p class="post__title-fr">{post.data.titleFr}</p>
                    )
                }
                <p class="post__meta">{meta}</p>

                <!-- Tags -->
                <div class="post__tags" role="list" aria-label="Etiquetas">
                    {
                        post.data.tags.map((tag) => (
                            <span class="post__tag" role="listitem">
                                #{tag}
                            </span>
                        ))
                    }
                </div>
            </div>
        </header>

        <!-- Content -->
        <div class="container post__content-wrap">
            <div class="prose post__content">
                <Content />
            </div>
        </div>

        <Divider style="fleur" />

        <!-- Related posts -->
        {
            relatedPosts.length > 0 && (
                <section
                    class="container post__related"
                    aria-labelledby="related-title"
                >
                    <h2 class="post__related-title" id="related-title">
                        Artículos relacionados
                    </h2>
                    <div class="post__related-grid">
                        {relatedPosts.map((rp) => {
                            const rpReadingTime =
                                rp.data.readingTime ??
                                getReadingTime(rp.body ?? "");
                            return (
                                <a
                                    href={`/blog/${rp.slug}`}
                                    class="related-card"
                                >
                                    <div
                                        class="related-card__cover"
                                        aria-hidden="true"
                                    />
                                    <div class="related-card__body">
                                        <span class="related-card__category">
                                            {rp.data.category}
                                        </span>
                                        <h3 class="related-card__title">
                                            {rp.data.title}
                                        </h3>
                                        <p class="related-card__meta">
                                            {getArticleMeta(
                                                rp.data.pubDate,
                                                rpReadingTime,
                                            )}
                                        </p>
                                    </div>
                                </a>
                            );
                        })}
                    </div>
                </section>
            )
        }

        <!-- CTA -->
        <aside class="post__cta container" aria-label="Llamado a la acción">
            <div class="post__cta-inner">
                <h2 class="post__cta-title">¿Quieres aprender francés?</h2>
                <p class="post__cta-sub">
                    Agenda tu primera clase.
                </p>
                <Button href="/agendar" variant="primary" size="lg"
                    >Agenda tu clase→</Button
                >
            </div>
        </aside>
    </article>
</BaseLayout>

<style>
    /* Hero */
    .post__hero {
        background: linear-gradient(135deg, #000000 0%, #1a0d2e 100%);
        padding-top: 120px;
        padding-bottom: var(--space-12);
        position: relative;
        overflow: hidden;
    }

    .post__hero-bg {
        position: absolute;
        inset: 0;
        background: radial-gradient(
            ellipse at top left,
            rgba(96, 64, 153, 0.3) 0%,
            transparent 60%
        );
        pointer-events: none;
    }

    .post__hero-content {
        position: relative;
        z-index: 1;
        max-width: 760px;
    }

    /* Breadcrumb */
    .post__breadcrumb {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: var(--space-3);
        flex-wrap: wrap;
    }

    .post__breadcrumb-link {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-gray);
        text-decoration: none;
        transition: color var(--transition-base);
    }

    .post__breadcrumb-link:hover {
        color: var(--accent-light);
    }

    .post__breadcrumb-sep {
        width: 14px;
        height: 14px;
        color: var(--color-gray);
        flex-shrink: 0;
    }

    .post__breadcrumb-current {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--accent-light);
    }

    /* Category */
    .post__category {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-white);
        background: var(--accent-primary);
        border-radius: var(--radius-pill);
        padding: 3px 12px;
        margin-bottom: var(--space-2);
        letter-spacing: 0.06em;
    }

    /* Title */
    .post__title {
        font-family: var(--font-heading);
        font-size: var(--text-4xl);
        font-weight: 700;
        color: var(--color-white);
        line-height: 1.15;
        margin-bottom: var(--space-1);
    }

    @media (min-width: 768px) {
        .post__title {
            font-size: var(--text-5xl);
        }
    }

    .post__title-fr {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--accent-light);
        letter-spacing: 0.08em;
        margin-bottom: var(--space-2);
        font-style: italic;
    }

    .post__meta {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-gray);
        margin-bottom: var(--space-2);
    }

    /* Tags */
    .post__tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .post__tag {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-gray);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-pill);
        padding: 3px 10px;
    }

    /* Content */
    .post__content-wrap {
        padding-top: var(--space-12);
        padding-bottom: var(--space-12);
    }

    .post__content {
        max-width: 720px;
    }

    /* Related */
    .post__related {
        padding-bottom: var(--space-12);
    }

    .post__related-title {
        font-family: var(--font-heading);
        font-size: var(--text-2xl);
        color: var(--color-white);
        margin-bottom: var(--space-4);
    }

    .post__related-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-4);
    }

    @media (min-width: 768px) {
        .post__related-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    .related-card {
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        overflow: hidden;
        text-decoration: none;
        display: flex;
        flex-direction: column;
        transition:
            border-color var(--transition-base),
            transform var(--transition-base),
            box-shadow var(--transition-base);
    }

    .related-card:hover {
        border-color: var(--accent-light);
        transform: translateY(-4px);
        box-shadow: var(--shadow-hover);
    }

    .related-card__cover {
        height: 140px;
        background: linear-gradient(
            135deg,
            var(--color-purple) 0%,
            #1a0d2e 100%
        );
    }

    .related-card__body {
        padding: var(--space-3);
        background: rgba(255, 255, 255, 0.03);
    }

    .related-card__category {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--accent-light);
        letter-spacing: 0.08em;
        display: block;
        margin-bottom: 6px;
        text-transform: uppercase;
    }

    .related-card__title {
        font-family: var(--font-heading);
        font-size: var(--text-xl);
        color: var(--color-white);
        margin-bottom: 6px;
        line-height: 1.3;
    }

    .related-card__meta {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-gray);
    }

    /* CTA section */
    .post__cta {
        padding-bottom: var(--space-16);
    }

    .post__cta-inner {
        background: linear-gradient(
            135deg,
            rgba(96, 64, 153, 0.2),
            rgba(187, 153, 255, 0.08)
        );
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        padding: var(--space-8);
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-2);
    }

    .post__cta-title {
        font-family: var(--font-heading);
        font-size: var(--text-3xl);
        color: var(--color-white);
    }

    .post__cta-sub {
        font-family: var(--font-body);
        font-size: var(--text-base);
        color: var(--color-gray);
    }
</style>
