---
import "../../styles/global.css";
import { ClientRouter } from "astro:transitions";
import BaseHead from "./BaseHead.astro";
import Navbar from "./Navbar.astro";
import Footer from "./Footer.astro";
import WhatsAppWidget from "../WhatsAppWidget.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import type { Lang } from "../../i18n/utils";

interface Props {
    title?: string;
    description?: string;
    image?: string;
    canonical?: string;
}

const lang = getLangFromUrl(Astro.url) as Lang;
const t = useTranslations(lang);
const seoDict = t("seo");

const {
    title = seoDict.title,
    description = seoDict.description,
    image = "/og-default.png",
    canonical,
} = Astro.props;

const SITE_NAME = "OuiPaula";
const fullTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;
---

<!doctype html>
<html lang={lang}>
    <head>
        <BaseHead
            title={fullTitle}
            description={description}
            image={image}
            canonical={canonical}
        />
        <ClientRouter />
        <!-- Additional head slot (for page-specific overrides) -->
        <slot name="head" />
    </head>
    <body>
        <Navbar />
        <main id="main-content">
            <slot />
        </main>
        <Footer />
        <WhatsAppWidget
            phoneNumber="573000000000"
            message={t("whatsapp").defaultMessage}
        />

        <!-- Client scripts re-hydrated on each page transition -->
        <script>
            import "../../scripts/navbar.ts";
            import "../../scripts/reveal.ts";
        </script>
    </body>
</html>
