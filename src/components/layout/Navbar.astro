---
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations, getRouteFromUrl, languages } from "../../i18n/utils";
import type { Lang } from "../../i18n/utils";
import { ROUTES } from "../../i18n/routes";

const lang = getLangFromUrl(Astro.url) as Lang;
const t = useTranslations(lang);
const nav = t("nav");

// Build anchor prefix: '' for es (default), '/en' or '/fr' for others
const prefix = lang === "es" ? "" : `/${lang}`;

// Language switcher URLs
const langUrls = Object.keys(languages).map((l) => ({
  code: l as Lang,
  label: languages[l as Lang],
  href: getRouteFromUrl(Astro.url, l as Lang),
  active: l === lang,
}));
---

<header class="navbar" id="navbar" role="banner">
    <div class="navbar__inner container">
        <!-- Logo -->
        <a href={ROUTES.home[lang]} class="navbar__logo" aria-label={nav.logoAriaLabel}>
            <Icon
                name="tabler:sparkles"
                class="navbar__logo-icon"
                aria-hidden="true"
            />
            <span class="navbar__logo-text">OuiPaula</span>
        </a>

        <!-- Desktop nav -->
        <nav class="navbar__nav" aria-label={nav.navAriaLabel}>
            <a href={`${prefix}/#inicio`} class="navbar__link">{nav.home}</a>
            <a href={`${prefix}/#sobre-mi`} class="navbar__link">{nav.about}</a>
            <a href={`${prefix}/#cursos`} class="navbar__link">{nav.courses}</a>
            <a href={`${prefix}/#metodologia`} class="navbar__link">{nav.methodology}</a>
            <a href={ROUTES.blog[lang]} class="navbar__link">{nav.blog}</a>
            <a href={`${prefix}/#contacto`} class="navbar__link">{nav.contact}</a>
        </nav>

        <!-- Language switcher (desktop) -->
        <div class="navbar__lang-switcher" aria-label={nav.langSwitcher}>
            {langUrls.map(({ code, label, href, active }) => (
                <a
                    href={href}
                    class:list={["lang-btn", { "lang-btn--active": active }]}
                    aria-current={active ? "true" : undefined}
                    hreflang={code}
                    title={label}
                >
                    {code.toUpperCase()}
                </a>
            ))}
        </div>

        <!-- CTA -->
        <a href={ROUTES.agendar[lang]} class="btn btn--primary navbar__cta">{nav.cta}</a>

        <!-- Hamburger -->
        <button
            class="navbar__hamburger"
            id="hamburger-btn"
            aria-label={nav.openMenu}
            aria-expanded="false"
            aria-controls="mobile-menu"
        >
            <span class="hamburger-bar"></span>
            <span class="hamburger-bar"></span>
            <span class="hamburger-bar"></span>
        </button>
    </div>
</header>

<!-- Mobile menu overlay -->
<div
    class="mobile-menu"
    id="mobile-menu"
    aria-hidden="true"
    role="dialog"
    aria-label={nav.menuAriaLabel}
>
    <nav class="mobile-menu__nav" aria-label={nav.mobileAriaLabel}>
        <a href={`${prefix}/#inicio`} class="mobile-menu__link" data-close-menu>{nav.home}</a>
        <a href={`${prefix}/#sobre-mi`} class="mobile-menu__link" data-close-menu>{nav.about}</a>
        <a href={`${prefix}/#cursos`} class="mobile-menu__link" data-close-menu>{nav.courses}</a>
        <a href={`${prefix}/#metodologia`} class="mobile-menu__link" data-close-menu>{nav.methodology}</a>
        <a href={ROUTES.blog[lang]} class="mobile-menu__link" data-close-menu>{nav.blog}</a>
        <a href={`${prefix}/#contacto`} class="mobile-menu__link" data-close-menu>{nav.contact}</a>
        <a href={ROUTES.agendar[lang]} class="btn btn--primary mobile-menu__cta" data-close-menu>{nav.cta}</a>

        <!-- Language switcher (mobile) -->
        <div class="mobile-menu__lang" aria-label={nav.langSwitcher}>
            {langUrls.map(({ code, label, href, active }) => (
                <a
                    href={href}
                    class:list={["lang-btn", "lang-btn--mobile", { "lang-btn--active": active }]}
                    aria-current={active ? "true" : undefined}
                    hreflang={code}
                    data-close-menu
                >
                    {label}
                </a>
            ))}
        </div>
    </nav>
</div>

<style>
    /* ── Navbar shell ───────────────────────────────────────── */
    .navbar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
        background: transparent;
        transition:
            background var(--transition-base),
            border-color var(--transition-base),
            backdrop-filter var(--transition-base);
        border-bottom: 1px solid transparent;
    }

    .navbar__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 72px;
    }

    /* ── Logo ──────────────────────────────────────────────────── */
    .navbar__logo {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        flex-shrink: 0;
    }

    .navbar__logo-icon {
        width: 24px;
        height: 24px;
        color: var(--accent-light);
        flex-shrink: 0;
    }

    .navbar__logo-text {
        font-family: var(--font-heading);
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--color-white);
        letter-spacing: 0.02em;
    }

    /* ── Desktop nav ──────────────────────────────────────────────── */
    .navbar__nav {
        display: none;
        align-items: center;
        gap: var(--space-3);
    }

    @media (min-width: 1024px) {
        .navbar__nav {
            display: flex;
        }
    }

    .navbar__link {
        font-family: var(--font-body);
        font-size: var(--text-sm);
        font-weight: 400;
        color: var(--color-white);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        text-decoration: none;
        position: relative;
        padding-bottom: 3px;
        transition: color var(--transition-base);
    }

    .navbar__link::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 1px;
        background: var(--accent-light);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform var(--transition-base);
    }

    .navbar__link:hover {
        color: var(--accent-light);
    }

    .navbar__link:hover::after {
        transform: scaleX(1);
    }

    /* ── Language switcher ───────────────────────────────────────────── */
    .navbar__lang-switcher {
        display: none;
        align-items: center;
        gap: 4px;
    }

    @media (min-width: 1024px) {
        .navbar__lang-switcher {
            display: flex;
        }
    }

    .lang-btn {
        font-family: var(--font-body);
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        color: rgba(255, 255, 255, 0.5);
        text-decoration: none;
        padding: 3px 6px;
        border-radius: var(--radius-sm);
        border: 1px solid transparent;
        transition:
            color var(--transition-base),
            border-color var(--transition-base),
            background var(--transition-base);
    }

    .lang-btn:hover {
        color: var(--accent-light);
        border-color: rgba(187, 153, 255, 0.3);
    }

    .lang-btn--active {
        color: var(--accent-light);
        border-color: rgba(187, 153, 255, 0.5);
        background: rgba(187, 153, 255, 0.08);
    }

    .lang-btn--mobile {
        font-size: var(--text-sm);
        padding: 6px 14px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: var(--color-white);
    }

    .lang-btn--mobile.lang-btn--active {
        border-color: var(--accent-light);
        color: var(--accent-light);
    }

    /* ── CTA button ──────────────────────────────────────────────────── */
    .navbar__cta {
        display: none;
    }

    @media (min-width: 1024px) {
        .navbar__cta {
            display: inline-flex;
        }
    }

    /* ── Hamburger ────────────────────────────────────────────────────── */
    .navbar__hamburger {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        width: 40px;
        height: 40px;
        background: none;
        border: none;
        cursor: pointer;
        padding: 8px;
        border-radius: var(--radius-sm);
        transition: background var(--transition-base);
    }

    .navbar__hamburger:hover {
        background: rgba(255, 255, 255, 0.08);
    }

    @media (min-width: 1024px) {
        .navbar__hamburger {
            display: none;
        }
    }

    .hamburger-bar {
        display: block;
        width: 24px;
        height: 2px;
        background: var(--color-white);
        border-radius: var(--radius-pill);
        transition:
            transform var(--transition-base),
            opacity var(--transition-base);
        transform-origin: center;
    }

    /* open state */
    .navbar__hamburger[aria-expanded="true"] .hamburger-bar:nth-child(1) {
        transform: translateY(7px) rotate(45deg);
    }
    .navbar__hamburger[aria-expanded="true"] .hamburger-bar:nth-child(2) {
        opacity: 0;
        transform: scaleX(0);
    }
    .navbar__hamburger[aria-expanded="true"] .hamburger-bar:nth-child(3) {
        transform: translateY(-7px) rotate(-45deg);
    }

    /* ── Mobile menu ─────────────────────────────────────────────────── */
    .mobile-menu {
        position: fixed;
        inset: 0;
        z-index: 99;
        background: rgba(0, 0, 0, 0.95);
        backdrop-filter: blur(12px);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        pointer-events: none;
        transition: opacity var(--transition-base);
    }

    .mobile-menu.is-open {
        opacity: 1;
        pointer-events: all;
    }

    @media (min-width: 1024px) {
        .mobile-menu {
            display: none;
        }
    }

    .mobile-menu__nav {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-3);
        text-align: center;
    }

    .mobile-menu__link {
        font-family: var(--font-heading);
        font-size: var(--text-3xl);
        font-weight: 500;
        color: var(--color-white);
        text-decoration: none;
        transition: color var(--transition-base);
    }

    .mobile-menu__link:hover {
        color: var(--accent-light);
    }

    .mobile-menu__cta {
        margin-top: var(--space-2);
    }

    .mobile-menu__lang {
        display: flex;
        gap: var(--space-2);
        margin-top: var(--space-3);
        padding-top: var(--space-3);
        border-top: 1px solid rgba(255, 255, 255, 0.1);
    }
</style>
