---
import { SEO } from "astro-seo";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import type { Lang } from "../../i18n/utils";
import {
    getCanonicalUrl,
    getOgImageUrl,
    getHreflangUrls,
    getXDefaultUrl,
} from "../../lib/seo";
import { createPersonSchema, createServiceSchema } from "../../lib/schemas";

interface Props {
    title: string;
    description: string;
    image?: string;
    canonical?: string;
}

const {
    title,
    description,
    image,
    canonical,
} = Astro.props;

const lang = getLangFromUrl(Astro.url) as Lang;
const t = useTranslations(lang);
const seoDict = t("seo");

// ── Canonical URL (from pathname, never from href) ─────────────
const canonicalUrl = canonical ?? getCanonicalUrl(Astro.url.pathname);

// ── OG Image (absolute, with fallback to og-default.png) ───────
const ogImageUrl = getOgImageUrl(image);

// ── Hreflang URLs (only for localizable routes) ────────────────
const hreflangLinks = getHreflangUrls(Astro.url.pathname);
const xDefaultHref = getCanonicalUrl(getXDefaultUrl());

// ── JSON-LD Structured Data ────────────────────────────────────
const personSchema = createPersonSchema({ description, lang });
const serviceSchema = createServiceSchema({ description, lang });
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!-- Hreflang tags (only for localizable routes) -->
{hreflangLinks?.map(({ hreflang, href }) => (
    <link rel="alternate" hreflang={hreflang} href={href} />
))}
<link rel="alternate" hreflang="x-default" href={xDefaultHref} />

<!-- astro-seo: dynamic title, description, OG, Twitter -->
<SEO
    title={title}
    description={description}
    canonical={canonicalUrl}
    openGraph={{
        basic: {
            title,
            type: "website",
            image: ogImageUrl,
            url: canonicalUrl,
        },
        optional: {
            description,
            locale: seoDict.ogLocale,
            siteName: "OuiPaula",
        },
        image: {
            alt: seoDict.ogImageAlt,
            width: 1200,
            height: 630,
        },
    }}
    twitter={{
        card: "summary_large_image",
        site: "@ouipaula",
        title,
        description,
        image: ogImageUrl,
        imageAlt: seoDict.twitterImageAlt,
    }}
    extend={{
        meta: [
            { name: "theme-color", content: "#604099" },
            { name: "robots", content: "index, follow" },
            { name: "author", content: "OuiPaula" },
        ],
        link: [{ rel: "sitemap", href: "/sitemap-index.xml" }],
    }}
/>

<!-- JSON-LD: Person schema -->
<script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />

<!-- JSON-LD: Service schema -->
<script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
