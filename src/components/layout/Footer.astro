---
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import type { Lang } from "../../i18n/utils";
import { ROUTES } from "../../i18n/routes";

const lang = getLangFromUrl(Astro.url) as Lang;
const t = useTranslations(lang);
const f = t("footer");
const prefix = lang === "es" ? "" : `/${lang}`;
const year = new Date().getFullYear();
---

<footer class="footer" role="contentinfo">
    <div class="container">
        <div class="footer__grid">
            <!-- Col 1: Brand -->
            <div class="footer__col footer__col--brand">
                <a href={ROUTES.home[lang]} class="footer__logo" aria-label={f.logoAriaLabel}>
                    <Icon
                        name="tabler:sparkles"
                        class="footer__logo-icon"
                        aria-hidden="true"
                    />
                    <span class="footer__logo-text">OuiPaula</span>
                </a>
                <p class="footer__tagline">{f.tagline}</p>
            </div>

            <!-- Col 2: Navigation -->
            <div class="footer__col">
                <h3 class="footer__heading">{f.navHeading}</h3>
                <nav aria-label={f.navHeading}>
                    <ul class="footer__links">
                        <li><a href={`${prefix}/#inicio`} class="footer__link">{f.links.home}</a></li>
                        <li><a href={`${prefix}/#sobre-mi`} class="footer__link">{f.links.about}</a></li>
                        <li><a href={`${prefix}/#cursos`} class="footer__link">{f.links.courses}</a></li>
                        <li><a href={`${prefix}/#metodologia`} class="footer__link">{f.links.methodology}</a></li>
                        <li><a href={ROUTES.blog[lang]} class="footer__link">{f.links.blog}</a></li>
                        <li><a href={ROUTES.agendar[lang]} class="footer__link">{f.links.book}</a></li>
                    </ul>
                </nav>
            </div>

            <!-- Col 3: Social -->
            <div class="footer__col">
                <h3 class="footer__heading">{f.socialHeading}</h3>
                <div class="footer__socials">
                    <a
                        href="https://www.linkedin.com/in/paula-cardenas-fle/"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="social-btn"
                        aria-label="LinkedIn"
                    >
                        <Icon
                            name="tabler:brand-linkedin"
                            class="social-btn__icon"
                            aria-hidden="true"
                        />
                    </a>
                    <!--<a-->
                    <!--    href="https://instagram.com"-->
                    <!--    target="_blank"-->
                    <!--    rel="noopener noreferrer"-->
                    <!--    class="social-btn"-->
                    <!--    aria-label="Instagram"-->
                    <!--&gt;-->
                    <!--    <Icon-->
                    <!--        name="tabler:brand-instagram"-->
                    <!--        class="social-btn__icon"-->
                    <!--        aria-hidden="true"-->
                    <!--    />-->
                    <!--</a>-->
                    <!--<a-->
                    <!--    href="https://youtube.com"-->
                    <!--    target="_blank"-->
                    <!--    rel="noopener noreferrer"-->
                    <!--    class="social-btn"-->
                    <!--    aria-label="YouTube"-->
                    <!--&gt;-->
                    <!--    <Icon-->
                    <!--        name="tabler:brand-youtube"-->
                    <!--        class="social-btn__icon"-->
                    <!--        aria-hidden="true"-->
                    <!--    />-->
                    <!--</a>-->
                </div>
            </div>
        </div>

        <!-- Bottom bar -->
        <div class="footer__bottom">
            <p class="footer__copy">
                {f.copyright.replace('{year}', String(year))}
            </p>
            <p class="footer__made">{f.madeWith} ♡ {f.madeWithSuffix}</p>
        </div>
    </div>
</footer>

<style>
    .footer {
        background: var(--color-black);
        border-top: 1px solid var(--border-color);
        padding-top: var(--space-12);
        padding-bottom: var(--space-4);
    }

    .footer__grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-8);
        margin-bottom: var(--space-8);
    }

    @media (min-width: 768px) {
        .footer__grid {
            grid-template-columns: 2fr 1fr 1fr;
            gap: var(--space-6);
        }
    }

    /* Logo */
    .footer__logo {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        margin-bottom: var(--space-2);
    }

    .footer__logo-icon {
        width: 22px;
        height: 22px;
        color: var(--accent-light);
    }

    .footer__logo-text {
        font-family: var(--font-heading);
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--color-white);
    }

    .footer__tagline {
        font-family: var(--font-body);
        font-size: var(--text-sm);
        color: var(--color-gray);
        line-height: 1.7;
        max-width: 280px;
        margin-top: var(--space-1);
    }

    /* Columns */
    .footer__heading {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 400;
        color: var(--accent-light);
        text-transform: uppercase;
        letter-spacing: 0.12em;
        margin-bottom: var(--space-2);
    }

    .footer__links {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
    }

    .footer__link {
        font-family: var(--font-body);
        font-size: var(--text-sm);
        color: var(--color-gray);
        text-decoration: none;
        transition: color var(--transition-base);
    }

    .footer__link:hover {
        color: var(--accent-light);
    }

    /* Socials */
    .footer__socials {
        display: flex;
        gap: var(--space-1);
        flex-wrap: wrap;
    }

    .social-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        transition:
            background var(--transition-base),
            border-color var(--transition-base);
        text-decoration: none;
    }

    .social-btn:hover {
        background: var(--accent-primary);
        border-color: var(--accent-primary);
    }

    .social-btn__icon {
        width: 18px;
        height: 18px;
        color: var(--accent-light);
    }

    .social-btn:hover .social-btn__icon {
        color: var(--color-white);
    }

    /* Bottom bar */
    .footer__bottom {
        border-top: 1px solid var(--border-color);
        padding-top: var(--space-4);
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: var(--space-2);
    }

    .footer__copy,
    .footer__made {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-gray);
    }
</style>
