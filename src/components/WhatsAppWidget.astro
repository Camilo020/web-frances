---
export interface Props {
  phoneNumber: string;
  message?: string;
  agentName?: string;
  tooltipText?: string;
  position?: 'bottom-right' | 'bottom-left';
}

const {
  phoneNumber,
  message = 'Hola Paula, me interesa agendar una clase de prueba gratuita. ¿Podrías darme más información?',
  agentName = 'Paula',
  tooltipText = '¿Tienes dudas? ¡Hablemos!',
  position = 'bottom-right',
} = Astro.props;

const encodedMessage = encodeURIComponent(message);
const whatsappUrl = `https://wa.me/${phoneNumber}?text=${encodedMessage}`;

const isRight = position === 'bottom-right';

const positionClass = {
  'bottom-right': 'right-4 sm:right-6 lg:right-8',
  'bottom-left': 'left-4 sm:left-6 lg:left-8',
} satisfies Record<NonNullable<Props['position']>, string>;

// ── Class composites ────────────────────────────────────────────
const tooltipWrapperClass = [
  'hidden sm:flex items-center',
  isRight ? 'order-first mr-2' : 'order-last ml-2',
];

const tooltipBubbleClass = [
  'relative bg-gray-800/95 backdrop-blur-sm text-gray-100 text-sm px-4 py-2.5 rounded-2xl shadow-xl border border-purple-500/20',
  'opacity-0 translate-x-2 group-hover:opacity-100 group-hover:translate-x-0',
  'transition-all duration-300 ease-out whitespace-nowrap',
  "before:content-[''] before:absolute before:top-1/2 before:-translate-y-1/2",
  'before:w-0 before:h-0 before:border-8 before:border-transparent',
  isRight
    ? 'before:-right-4 before:border-l-gray-800/95'
    : 'before:-left-4 before:border-r-gray-800/95',
];
---

<a
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Contactar a ${agentName} por WhatsApp`}
  class:list={[
    'group fixed bottom-4 sm:bottom-6 lg:bottom-8 z-50 flex items-center gap-3 transition-all duration-300 ease-out',
    positionClass[position],
  ]}
>
  <!-- Tooltip -->
  <div class:list={tooltipWrapperClass}>
    <div class:list={tooltipBubbleClass}>
      <span class="font-medium">{tooltipText}</span>
      <span class="absolute -top-1 -right-1 flex h-3 w-3">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-3 w-3 bg-purple-500"></span>
      </span>
    </div>
  </div>

  <!-- Botón principal -->
  <div
    class="relative flex items-center justify-center w-14 h-14 sm:w-16 sm:h-16
           bg-gradient-to-br from-purple-600 via-purple-700 to-indigo-800
           hover:from-purple-500 hover:via-purple-600 hover:to-indigo-700
           rounded-full shadow-lg shadow-purple-900/50
           hover:shadow-xl hover:shadow-purple-800/60
           transform hover:scale-110 active:scale-95
           transition-all duration-300 ease-out
           ring-2 ring-purple-400/30 hover:ring-purple-400/50
           animate-subtle-pulse"
  >
    <!-- Glow -->
    <div class="absolute inset-0 rounded-full bg-purple-500/20 blur-xl animate-pulse"></div>

    <!-- Icono WhatsApp SVG -->
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="currentColor"
      class="relative z-10 w-7 h-7 sm:w-8 sm:h-8 text-white drop-shadow-md"
      aria-hidden="true"
    >
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
    </svg>

    <!-- Badge de notificación -->
    <span class="absolute -top-1 -right-1 flex h-4 w-4 sm:h-5 sm:w-5">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-4 w-4 sm:h-5 sm:w-5 bg-green-500 border-2 border-gray-900"></span>
    </span>
  </div>

  <!-- Texto móvil -->
  <span class="sm:hidden absolute -bottom-6 left-1/2 -translate-x-1/2 text-xs text-gray-400 font-medium whitespace-nowrap opacity-70">
    {agentName}
  </span>
</a>
