---
import SectionHeader from "../ui/SectionHeader.astro";
import Badge from "../ui/Badge.astro";
---

<section class="about section" id="sobre-mi" aria-labelledby="about-title">
    <div class="container">
        <div class="about__grid">
            <!-- Image block -->
            <div class="about__image-wrap reveal">
                <div class="about__image-frame" aria-hidden="true"></div>
                <div class="about__image-inner">
                    <!-- Placeholder gradient -->
                    <svg
                        viewBox="0 0 400 500"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                        class="about__image-placeholder"
                        aria-label="Foto de la profesora"
                    >
                        <rect
                            width="400"
                            height="500"
                            rx="20"
                            fill="url(#aboutGrad)"></rect>
                        <defs>
                            <linearGradient
                                id="aboutGrad"
                                x1="0%"
                                y1="0%"
                                x2="100%"
                                y2="100%"
                            >
                                <stop
                                    offset="0%"
                                    style="stop-color:#1A0D2E;stop-opacity:1"
                                ></stop>
                                <stop
                                    offset="100%"
                                    style="stop-color:#604099;stop-opacity:1"
                                ></stop>
                            </linearGradient>
                        </defs>
                        <circle
                            cx="200"
                            cy="180"
                            r="80"
                            fill="rgba(187,153,255,0.25)"></circle>
                        <ellipse
                            cx="200"
                            cy="370"
                            rx="110"
                            ry="80"
                            fill="rgba(187,153,255,0.15)"></ellipse>
                    </svg>
                </div>
            </div>

            <!-- Content block -->
            <div class="about__content reveal">
                <SectionHeader
                    eyebrow="À propos de moi"
                    title="Sobre mí"
                    align="left"
                />

                <p class="about__bio">
                    Soy filóloga en lengua francesa y llevo más de 5 años
                    enseñando a adultos a comunicarse con fluidez, confianza y
                    autenticidad. Para mí, aprender francés es también descubrir
                    una forma diferente de ver el mundo.
                </p>

                <!-- Credentials -->
                <div
                    class="about__credentials"
                    role="list"
                    aria-label="Credenciales"
                >
                    <div role="listitem">
                        <Badge
                            icon="tabler:school"
                            label="Filóloga en Francés"
                        />
                    </div>
                    <div role="listitem">
                        <Badge
                            icon="tabler:certificate"
                            label="DALF C1 Certificada"
                        />
                    </div>
                    <div role="listitem">
                        <Badge icon="tabler:star" label="+200 estudiantes" />
                    </div>
                    <div role="listitem">
                        <Badge
                            icon="tabler:world"
                            label="Bogotá · Online LATAM"
                        />
                    </div>
                </div>

                <!-- Pull quote -->
                <figure
                    class="about__pullquote"
                    aria-label="Cita inspiracional"
                >
                    <div class="about__pullquote-guillemets" aria-hidden="true">
                        «
                    </div>
                    <blockquote class="about__pullquote-text">
                        La langue est la maison de l'être.
                    </blockquote>
                    <figcaption class="about__pullquote-attr">
                        — Martin Heidegger
                    </figcaption>
                </figure>
            </div>
        </div>
    </div>
</section>

<style>
    .about {
        background: var(--bg-subtle);
    }

    .about__grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-12);
        align-items: center;
    }

    @media (min-width: 768px) {
        .about__grid {
            grid-template-columns: 45fr 55fr;
        }
    }

    /* ── Image ─────────────────────────────────────────────────── */
    .about__image-wrap {
        position: relative;
        max-width: 420px;
        margin: 0 auto;
        width: 100%;
    }

    /* Decorative offset frame */
    .about__image-frame {
        position: absolute;
        inset: 0;
        border: 2px solid var(--accent-primary);
        border-radius: var(--radius-lg);
        transform: translate(16px, 16px);
        z-index: 0;
    }

    .about__image-inner {
        position: relative;
        z-index: 1;
        border-radius: var(--radius-lg);
        overflow: hidden;
    }

    .about__image-placeholder {
        width: 100%;
        height: auto;
        display: block;
    }

    /* ── Content ───────────────────────────────────────────────── */
    .about__bio {
        font-family: var(--font-body);
        font-size: var(--text-lg);
        color: var(--color-gray);
        line-height: 1.8;
        margin-bottom: var(--space-6);
    }

    .about__credentials {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-2);
        margin-bottom: var(--space-6);
    }

    @media (max-width: 480px) {
        .about__credentials {
            grid-template-columns: 1fr;
        }
    }

    /* ── Pull quote ────────────────────────────────────────────── */
    .about__pullquote {
        position: relative;
        margin-top: var(--space-4);
        padding-left: var(--space-3);
        border-left: none;
    }

    .about__pullquote-guillemets {
        font-family: var(--font-heading);
        font-size: 64px;
        font-weight: 700;
        color: var(--accent-light);
        line-height: 0.7;
        margin-bottom: var(--space-1);
        display: block;
    }

    .about__pullquote-text {
        font-family: var(--font-heading);
        font-style: italic;
        font-size: var(--text-xl);
        color: var(--color-white);
        line-height: 1.5;
        border: none;
        padding: 0;
        margin: 0 0 8px 0;
    }

    .about__pullquote-attr {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-gray);
        letter-spacing: 0.05em;
    }
</style>
