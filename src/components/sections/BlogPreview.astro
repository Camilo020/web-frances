---
import SectionHeader from '../ui/SectionHeader.astro';
import Button from '../ui/Button.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { getReadingTime, getArticleMeta } from '../../lib/utils';
import { getLangFromUrl } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';
import { ROUTES } from '../../i18n/routes';

const lang = getLangFromUrl(Astro.url) as Lang;

const allPosts = await getCollection('blog', ({ data }: CollectionEntry<'blog'>) => !data.draft);
const recentPosts = allPosts
  .sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 4);
---

<section class="blog-preview section" id="blog" aria-labelledby="blog-preview-title">
  <div class="container">
    <SectionHeader
      eyebrow="Ressources gratuites"
      title="Recursos gratuitos"
      subtitle="Tips, guías y consejos para tu aprendizaje del francés. Sin costo, sin registro."
      align="center"
    />

    <div class="blog-preview__grid">
      {recentPosts.map((post) => {
        const readingTime = post.data.readingTime ?? getReadingTime(post.body ?? '');
        const meta = getArticleMeta(post.data.pubDate, readingTime);
        return (
          <article class="post-card reveal" aria-labelledby={`post-title-${post.slug}`}>
            <!-- Cover -->
            <a href={`${ROUTES.blog[lang]}${post.slug}/`} class="post-card__cover-link" tabindex="-1" aria-hidden="true">
              <div class="post-card__cover">
                <span class="post-card__category">{post.data.category}</span>
              </div>
            </a>

            <!-- Body -->
            <div class="post-card__body">
              <p class="post-card__meta">{meta}</p>
              <h3 class="post-card__title" id={`post-title-${post.slug}`}>
                <a href={`${ROUTES.blog[lang]}${post.slug}/`} class="post-card__title-link">
                  {post.data.title}
                </a>
              </h3>
              <p class="post-card__excerpt">{post.data.description}</p>
              <a href={`${ROUTES.blog[lang]}${post.slug}/`} class="post-card__read-more">
                Leer artículo <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        );
      })}
    </div>

    <div class="blog-preview__cta">
      <Button href={ROUTES.blog[lang]} variant="outline">Ver todos los artículos</Button>
    </div>
  </div>
</section>

<style>
  .blog-preview {
    background: var(--bg-subtle);
  }

  .blog-preview__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  @media (min-width: 768px) {
    .blog-preview__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1280px) {
    .blog-preview__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* ── Post Card ─────────────────────────────────────────────── */
  .post-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition:
      transform var(--transition-base),
      border-color var(--transition-base),
      box-shadow var(--transition-base);
  }

  .post-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent-light);
    box-shadow: var(--shadow-hover);
  }

  /* Cover */
  .post-card__cover-link {
    display: block;
  }

  .post-card__cover {
    height: 200px;
    background: linear-gradient(135deg, var(--color-purple) 0%, var(--color-black) 100%);
    position: relative;
    display: flex;
    align-items: flex-end;
    padding: var(--space-2);
  }

  .post-card__category {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-white);
    background: var(--accent-primary);
    border-radius: var(--radius-pill);
    padding: 3px 10px;
  }

  /* Body */
  .post-card__body {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    flex: 1;
  }

  .post-card__meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-gray);
  }

  .post-card__title {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-white);
    line-height: 1.3;
    flex: 1;
  }

  .post-card__title-link {
    text-decoration: none;
    color: inherit;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color var(--transition-base);
  }

  .post-card__title-link:hover {
    color: var(--accent-light);
  }

  .post-card__excerpt {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-gray);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card__read-more {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent-light);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: var(--space-1);
    transition: gap var(--transition-base), color var(--transition-base);
  }

  .post-card__read-more:hover {
    gap: 10px;
    color: var(--color-white);
  }

  .blog-preview__cta {
    display: flex;
    justify-content: center;
  }
</style>
