---
import BaseLayout from "../components/layout/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout
    title="Página no encontrada | OuiPaula"
    description="La página que buscas no existe. Vuelve al inicio."
>
    <section class="not-found" aria-labelledby="not-found-title">
        <div class="not-found__bg" aria-hidden="true"></div>
        <div class="container not-found__content">
            <p class="not-found__code" aria-hidden="true">404</p>
            <h1 class="not-found__title" id="not-found-title">
                Cette page n'existe pas
            </h1>
            <p class="not-found__subtitle">
                La página que buscas no existe o fue movida.
            </p>
            <div class="not-found__cta">
                <Button href="/" variant="primary">Volver al inicio</Button>
                <Button href="/blog" variant="outline">Ver el blog</Button>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .not-found {
        min-height: 100svh;
        display: flex;
        align-items: center;
        background: var(--color-black);
        position: relative;
        overflow: hidden;
    }

    .not-found__bg {
        position: absolute;
        inset: 0;
        background: radial-gradient(
            ellipse at center,
            rgba(96, 64, 153, 0.2) 0%,
            transparent 70%
        );
        pointer-events: none;
    }

    .not-found__content {
        text-align: center;
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-3);
        padding-top: 80px;
        padding-bottom: var(--space-12);
    }

    .not-found__code {
        font-family: var(--font-heading);
        font-size: 10rem;
        font-weight: 700;
        line-height: 1;
        background: linear-gradient(
            90deg,
            var(--color-purple),
            var(--color-lavender)
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        opacity: 0.5;
    }

    .not-found__title {
        font-family: var(--font-heading);
        font-size: var(--text-4xl);
        font-weight: 600;
        color: var(--color-white);
    }

    .not-found__subtitle {
        font-family: var(--font-body);
        font-size: var(--text-lg);
        color: var(--color-gray);
    }

    .not-found__cta {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        justify-content: center;
        margin-top: var(--space-2);
    }
</style>
