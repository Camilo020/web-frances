---
/**
 * Spanish blog posts — /blog/[slug]/
 * Renders posts in ES only (no prefix, default locale).
 */
import PostLayout from "../../components/blog/PostLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import type { GetStaticPaths } from "astro";

interface StaticPath {
    params: { slug: string };
    props: { post: CollectionEntry<"blog"> };
}

export const getStaticPaths = (async () => {
    const posts = await getCollection("blog", ({ data }) => 
        data.lang === "es" && !data.draft
    );

    const paths: StaticPath[] = posts.map((post) => ({
        params: { slug: post.id.split(".")[0] },
        props: { post },
    }));

    return paths;
}) satisfies GetStaticPaths;

const { post } = Astro.props;
---

<PostLayout post={post} />
