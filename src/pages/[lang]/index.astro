---
/**
 * Dynamic locale pages — handles /en/ and /fr/ routes.
 * Spanish (default) stays at / via src/pages/index.astro.
 * getStaticPaths() is the single source of truth for non-default locales.
 */
import type { GetStaticPaths } from "astro";
import HomePage from "../../components/pages/HomePage.astro";

export const getStaticPaths = (() => {
  return [
    { params: { lang: "en" } },
    { params: { lang: "fr" } },
  ];
}) satisfies GetStaticPaths;
---

<HomePage lang={Astro.params.lang as "en" | "fr"} />
